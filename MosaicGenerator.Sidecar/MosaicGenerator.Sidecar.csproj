    <RootNamespace>MosaicGenerator.Sidecar</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\MosaicGenerator.Core\MosaicGenerator.Core.csproj" />
  </ItemGroup>

</Project>
