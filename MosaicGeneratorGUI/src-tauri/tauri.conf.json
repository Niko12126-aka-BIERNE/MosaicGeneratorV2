{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Mosaic Generator",
  "version": "0.1.0",
  "identifier": "com.mosaicgenerator.gui",
  "build": {
    "beforeDevCommand": "npm run sidecar && npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run sidecar && npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Mosaic Generator",
        "width": 1000,
        "height": 760,
        "minWidth": 720,
        "minHeight": 560,
        "center": true,
        "theme": "Dark",
        "backgroundColor": "#0a0a0a"
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": [
          "**"
        ]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "externalBin": [
      "binaries/mosaic-sidecar"
    ]
  }
}
